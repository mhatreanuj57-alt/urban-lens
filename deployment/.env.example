# Copy to .env and fill in real values
# Backend
DATABASE_URL=postgresql+asyncpg://urban:urban@localhost:5432/urbanlens
DATABASE_URL_SYNC=postgresql://urban:urban@localhost:5432/urbanlens
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-string

# Storage (MinIO default)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PRIVATE=urbanlens-private
STORAGE_BUCKET_PUBLIC=urbanlens-public
STORAGE_REGION=ap-south-1

# ML
ML_MODEL_PATH=../ml/models
ML_DEVICE=cpu

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
